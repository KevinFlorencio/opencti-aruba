{
	admin off
	skip_install_trust
}

# Public, read-only threat radar + blog
http://192.168.0.180 {
	root * /srv/radar
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	try_files {path} {path}/ {path}/index.html /404.html
	file_server
}

# OpenCTI UI / API.
# A catch-all :8443 with an explicit certificate is used instead of an IP site
# address: browsers do not send SNI for IP literals, so Caddy's internal
# hostname-based certificate selection rejects the handshake. The certificate
# is generated by scripts/gen-env.sh (SAN: the VM IP).
:8443 {
	tls /etc/caddy/certs/opencti.crt /etc/caddy/certs/opencti.key
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy opencti:8080
}
