COMPOSE_PROJECT_NAME=misp
TZ=America/Aruba

# Public URL of this MISP instance (browser + API)
BASE_URL=https://192.168.0.180:9443
NGINX_HTTP_PORT=9080
NGINX_HTTPS_PORT=9443

# Upstream image tags
CORE_TAG=v2.5.51
MODULES_TAG=v3.1.3
GUARD_TAG=v1.4.1
CORE_RUNNING_TAG=latest
MODULES_RUNNING_TAG=latest

# First-boot administrator (MISP_* names are used by configure_misp.sh)
ADMIN_EMAIL=admin@aruba-ti.local
ADMIN_ORG=Aruba Threat Intel
ADMIN_ORG_UUID=
ADMIN_PASSWORD=CHANGE_ME
ADMIN_KEY=CHANGE_ME_UUID4
GPG_PASSPHRASE=CHANGE_ME

# Instance secrets (hex/random, no special characters in DB passwords)
ENCRYPTION_KEY=CHANGE_ME_32_CHARS
SALT=CHANGE_ME_32_CHARS
UUID=CHANGE_ME_UUID4

# Database / cache
MYSQL_HOST=db
MYSQL_USER=misp
MYSQL_PASSWORD=CHANGE_ME_ALNUM
MYSQL_ROOT_PASSWORD=CHANGE_ME_ALNUM
MYSQL_DATABASE=misp
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_ALNUM
ENABLE_REDIS_EMPTY_PASSWORD=false

# Behaviour
ENABLE_BACKGROUND_UPDATES=true
INNODB_BUFFER_POOL_SIZE=1024M
NUM_WORKERS_DEFAULT=3
NUM_WORKERS_PRIO=3
NUM_WORKERS_EMAIL=2
NUM_WORKERS_UPDATE=1
NUM_WORKERS_CACHE=3

# Mail (optional; leave blank to disable outbound)
SMARTHOST_ADDRESS=
SMARTHOST_PORT=25
SMARTHOST_USER=
SMARTHOST_PASSWORD=
SMARTHOST_ALIASES=
