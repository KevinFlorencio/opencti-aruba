---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const u = (p: string) => base + p.replace(/^\//, '');
---

<Layout title="Signal lost — Aruba Threat Radar" description="Page not found.">
  <section class="hero" style="min-height:52vh;display:grid;place-items:center;text-align:center">
    <div class="wrap">
      <div class="eyebrow" style="color:var(--red);border-color:rgba(251,113,133,.25)">404 · signal lost</div>
      <h1 style="margin:18px auto 12px;max-width:20ch">This track is not on the radar.</h1>
      <p class="lede" style="margin:0 auto 24px">The page you were looking for does not exist, moved, or was never published.</p>
      <a class="section-link" href={u('/')}>← Return to the radar</a>
    </div>
  </section>
</Layout>
