# ─────────────────────────────────────────────────────────────
# Aruba Threat Intel — OpenCTI stack
# Copy to .env and fill in every secret. Never commit .env.
# ─────────────────────────────────────────────────────────────

COMPOSE_PROJECT_NAME=opencti-aruba

# Public base URL of the OpenCTI UI (Caddy terminates TLS on :8443)
OPENCTI_BASE_URL=https://192.168.0.180:8443

# Bootstrap administrator (created on first start only)
OPENCTI_ADMIN_EMAIL=admin@aruba-ti.local
OPENCTI_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
OPENCTI_ADMIN_TOKEN=CHANGE_ME_UUID4
OPENCTI_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
OPENCTI_HEALTHCHECK_ACCESS_KEY=CHANGE_ME_UUID4

# Elasticsearch JVM heap (keep at or below half of the VM RAM)
ELASTIC_MEMORY_SIZE=6G

# Object storage (S3-compatible)
MINIO_ROOT_USER=opencti
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Message bus
RABBITMQ_DEFAULT_USER=opencti
RABBITMQ_DEFAULT_PASS=CHANGE_ME_STRONG_PASSWORD

# MISP (local instance) — API key is created after MISP first boot
MISP_URL=https://192.168.0.180:9443
MISP_API_KEY=CHANGE_ME_MISP_API_KEY

# Optional CTI source keys (leave blank to disable that connector profile)
ALIENVAULT_API_KEY=
ABUSECH_AUTH_KEY=
RANSOMWARELIVE_API_KEY=

# Static site
SITE_ADDRESS=http://192.168.0.180
